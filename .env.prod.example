# Production stack environment template (Phase 9.1).
# Copy to `.env` (gitignored) ONLY for local production-stack runs, or export
# the variables directly. NEVER commit a filled-in file.
#
# The ONLY secret here is POSTGRES_PASSWORD. It has no default anywhere
# (compose fails fast without it) and must be URL-safe: URL-encode any of
# `: @ / ? #` it contains, because it is interpolated into DATABASE_URL.

# REQUIRED — PostgreSQL password for the production-style stack.
# Example (local only): POSTGRES_PASSWORD=livepulse-prod-local-only
POSTGRES_PASSWORD=

# Optional identifiers (non-secret; defaults shown):
# POSTGRES_USER=livepulse
# POSTGRES_DB=livepulse

# Optional application tuning (defaults shown):
# LOG_LEVEL=info
# DISTRIBUTION_ENABLED=true
# METRICS_ENABLED=true
# WS_HEARTBEAT_INTERVAL_MS=30000
# PRESENCE_DIGEST_INTERVAL_MS=10000

# Load testing environment template. Copy to `.env` and edit only what you need.
# NEVER commit a real `.env` file.

# Application
NODE_ENV=development

# HTTP port the Fastify server listens on (0 = OS-assigned ephemeral, tests only)
PORT=3000

# PostgreSQL connection string (docker compose maps host port 5433 -> container 5432)
DATABASE_URL=postgresql://livepulse:livepulse@localhost:5433/livepulse

# Redis connection string (docker compose maps host port 6380 -> container 6379)
REDIS_URL=redis://localhost:6380

# Minimum log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# WebSocket server heartbeat interval in ms (server pings clients on this cadence)
WS_HEARTBEAT_INTERVAL_MS=30000

# Unique application-instance identity (Phase 4 distribution layer).
# Random per process when omitted; pin it per service in docker-compose.scale.yml.
# INSTANCE_ID=ws-a

# Phase 4 distribution layer master switch (true = subscribe + publish notices).
# Set false to run strict single-instance mode (no Redis usage at all).
DISTRIBUTION_ENABLED=true

# Phase 7 observability: whether GET /metrics is registered. Unauthenticated.
METRICS_ENABLED=true

# Phase 7 presence digest interval in ms (3 x this = stale peer expiry).
PRESENCE_DIGEST_INTERVAL_MS=10000

// LivePulse — domain schema (Phase 1).
// Documented in docs/database/schema.md; decisions in docs/decisions/002-domain-schema.md.
// Redis-specific structures are deliberately absent: PostgreSQL is the durable
// source of truth only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionState {
  CREATED
  LIVE
  ENDED
}

enum ParticipantRole {
  TEACHER
  STUDENT
}

enum QuizState {
  DRAFT
  ACTIVE
  COMPLETED
}

enum QuestionState {
  DRAFT
  PUBLISHED
  CLOSED
}

enum DoubtStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Global identity. No credentials yet (authentication is a later phase).
/// displayName IS unique: the Phase 3 development identity seam resolves a
/// connection to a stable user by name (see docs/decisions/002 + Phase 3 docs).
model User {
  id          String   @id @default(uuid(7))
  displayName String   @unique @db.VarChar(100)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  createdSessions       Session[]            @relation("SessionCreator")
  sessionParticipations SessionParticipant[]
  credentials           Credential?
  authSessions          AuthSession[]

  @@map("users")
}

/// Email + password login identity (Phase 10.2).
///
/// Separate table (not nullable columns on User) so pre-auth users remain
/// naturally credential-less: existing Phase 1–9 rows are untouched and
/// simply cannot authenticate until claimed. Email is canonicalized in
/// application code (trim + lowercase on both write and lookup paths)
/// because the unique index is case-sensitive.
model Credential {
  id           String   @id @default(uuid(7))
  userId       String   @unique
  email        String   @unique @db.VarChar(320)
  passwordHash String   @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("credentials")
}

/// Server-side refresh-token session (Phase 10.2).
///
/// Only the sha256 hash of the refresh token is stored (the token itself is
/// shown to the client once). Rotation links the replacement to its
/// predecessor via rotatedFromId; a presented token hashing to an already
/// revokedAt session signals reuse. Revocation never touches the User row:
/// deleting a user removes their sessions (Cascade) while credential
/// deletion cannot cascade into history (Restrict on Credential).
model AuthSession {
  id               String    @id @default(uuid(7))
  userId           String
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  rotatedFromId    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// A live classroom with an explicit lifecycle:
/// CREATED -> LIVE -> ENDED, plus CREATED -> ENDED (cancel before live).
/// Transitions are enforced by atomic conditional updates in
/// SessionRepository — see ADR-002 for why there is no trigger (yet).
model Session {
  id        String       @id @default(uuid(7))
  name      String       @db.VarChar(200)
  state     SessionState @default(CREATED)
  creatorId String
  /// Per-session doubt enqueue counter (Phase 6). Locked and incremented in
  /// the same transaction that inserts a doubt, so doubt.enqueueSeq order ==
  /// durable acceptance (commit) order. Server-owned; never client-set.
  doubtSeq  Int          @default(0)
  startedAt DateTime?    @db.Timestamptz(6)
  endedAt   DateTime?    @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)

  creator User @relation("SessionCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  participants SessionParticipant[]
  quizzes      Quiz[]
  doubts       Doubt[]

  @@index([creatorId])
  @@map("sessions")
}

/// User-in-a-session with session-scoped state (role, join time).
/// UNIQUE (sessionId, userId): one membership per user per session.
model SessionParticipant {
  id        String          @id @default(uuid(7))
  sessionId String
  userId    String
  role      ParticipantRole @default(STUDENT)
  joinedAt  DateTime        @default(now()) @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  answers Answer[]
  doubts  Doubt[]

  @@unique([sessionId, userId])
  @@index([userId])
  @@map("session_participants")
}

/// A quiz run inside a session. Modeled lifecycle DRAFT -> ACTIVE ->
/// COMPLETED; transitions are driven by teacher actions in a later phase.
model Quiz {
  id        String    @id @default(uuid(7))
  sessionId String
  title     String    @db.VarChar(200)
  state     QuizState @default(DRAFT)
  startedAt DateTime? @db.Timestamptz(6)
  endedAt   DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questions Question[]

  @@index([sessionId])
  @@map("quizzes")
}

/// One quiz item. UNIQUE (quizId, position) gives deterministic delivery
/// order. correctAnswer is nullable: unkeyed questions stay ungraded.
/// firstCorrectWins is the Phase 4 semantics flag.
model Question {
  id               String        @id @default(uuid(7))
  quizId           String
  position         Int
  prompt           String        @db.Text
  correctAnswer    String?       @db.Text
  firstCorrectWins Boolean       @default(true)
  state            QuestionState @default(DRAFT)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers Answer[]

  @@unique([quizId, position])
  @@map("questions")
}

/// A participant's submission. Append-style rows with attemptNumber support
/// retry policies; UNIQUE (questionId, participantId, attemptNumber) makes
/// duplicate attempts impossible at the database level. isWinner is the
/// first-correct-answer election result: enforced to at most one per question
/// by a PARTIAL unique index (see docs/decisions/004 — index lives in the
/// migration SQL because Prisma cannot express partial indexes).
model Answer {
  id            String   @id @default(uuid(7))
  questionId    String
  participantId String
  content       String   @db.Text
  attemptNumber Int      @default(1)
  isCorrect     Boolean?
  isWinner      Boolean  @default(false)
  submittedAt   DateTime @default(now()) @db.Timestamptz(6)

  question    Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participant SessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([questionId, participantId, attemptNumber])
  @@index([questionId, submittedAt])
  @@index([participantId])
  @@map("answers")
}

/// Durable record of a doubt raised in a session (Phase 6 queue).
///
/// The queue IS PostgreSQL — Redis is notification only (ADR-007). Ordering
/// is by (priority DESC, enqueueSeq ASC) over OPEN rows: enqueueSeq is a
/// per-session monotonically increasing integer assigned by PostgreSQL inside
/// the inserting transaction while holding the session row lock, so sequence
/// order equals durable acceptance (commit) order. It is never client-set.
///
/// `doubtRequestId` is an optional client idempotency key: a retried create
/// with the same key resolves to the existing row (checked in-transaction).
model Doubt {
  id             String      @id @default(uuid(7))
  sessionId      String
  participantId  String
  content        String      @db.Text
  priority       Int         @default(0)
  /// Per-session queue sequence — the ordering authority (server-assigned).
  enqueueSeq     Int
  /// Optional client idempotency key (partial unique index in the migration).
  doubtRequestId String?     @db.VarChar(64)
  status         DoubtStatus @default(OPEN)
  resolvedAt     DateTime?   @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  participant SessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enqueueSeq])
  /// The queue read: OPEN doubts of a session in canonical order.
  @@index([sessionId, status, priority(sort: Desc), enqueueSeq(sort: Asc)])
  @@index([participantId])
  @@map("doubts")
}
